# DEV-002 local Docker Compose defaults.
# Copy to .env for local work or run: docker compose --env-file .env.example up -d --build

POSTGRES_DB=pfi_backend
POSTGRES_USER=pfi
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_PORT=54329

AI_MODULE_PORT=8000
AI_MODEL_DIR=../PFI_MVPTest_Enzo_AImodule/models/final
# Directorios locales que contienen exactamente los artefactos congelados. No se suben a Git.
PFI_SUBARTICULAR_CHECKPOINT_DIR=../PFI_MVPTest_Enzo_AImodule/models/subarticular
PFI_P10_7_CHECKPOINT_DIR=../PFI_MVPTest_Enzo_AImodule/models/disc-degenerative
PFI_P10_7_DEVICE=cpu

BACKEND_PORT=8080
# URL con la que el navegador llega al backend. Se usa dos veces: como argumento de build
# del frontend y como BACKEND_URL de su entrypoint, que la inyecta en env.js. Es una URL
# del host, no de la red interna de Docker: el navegador no resuelve `http://backend:8080`.
BACKEND_PUBLIC_URL=http://localhost:8080
PFI_AI_TIMEOUT_SECONDS=180
PFI_AUTH_JWT_SECRET=change-me-local-jwt-secret
PFI_CORS_ALLOWED_ORIGINS=http://localhost:8088

# Contrato que el backend le habla al modulo de IA. v1 no transporta la metadata
# volumetrica del .mha (canonicalShape, sliceCount, selectedAxis, orientationTransform),
# asi que una corrida sagital real queda marcada como no evaluable en el frontend.
PFI_AI_SERVICE_MULTIPLANAR_CONTRACT_VERSION=v2

# Techo del zip de estudio completo, en bytes. Un estudio de RM lumbar con todas sus
# series ronda las decenas de MB; 200 MB acota un envio desbocado sin rechazar uno real.
# El compose se lo pasa al backend y tambien al modulo de IA (como PFI_MAX_UPLOAD_BYTES).
PFI_AI_STUDY_UPLOAD_MAX_BYTES=209715200

# Solo para desarrollo local: habilita POST /api/auth/demo-doctor, que emite un token con
# rol ADMIN/DOCTOR/REVIEWER sin registro previo. compose.local.yml es el modo de desarrollo
# y lo habilita para poder recorrer el producto. Apagarlo en cualquier entorno accesible
# desde afuera; compose.yml mantiene un ejemplo separado en .env.registry.example.
PFI_AUTH_DEMO_ENABLED=true

# Identidad esperada del release sagital. El backend rechaza una corrida strict cuyo
# modelo o hash no coincida con esto.
#
# OJO: el compose NO le pasa estas variables al contenedor del backend. Ponerlas en el
# .env no cambia nada en Docker; los valores efectivos son los defaults de
# application.properties, que son exactamente estos mismos. Sirven para ejecutar el
# backend fuera de Docker o para un deploy que las declare explicitamente.
PFI_SAGITTAL_EXPECTED_MODEL_KEY=sagittal_spider
PFI_SAGITTAL_EXPECTED_MODEL_VERSION=sagittal-spider-final-v1
PFI_SAGITTAL_EXPECTED_MODEL_SHA256=cf11dcc0ad77a7c787e64a796a2fd7398ef906add461cef4b3d61f1a5238e944
PFI_SAGITTAL_EXPECTED_RELEASE_ID=sagittal_spider_final_v1
PFI_SAGITTAL_EXPECTED_RELEASE_CONTENT_SHA256=7420ad4271fe634c970b2a543d1ef8fb1437888c99ca8bd5733a06e5f63e3e7e
PFI_SAGITTAL_EXPECTED_RELEASE_MANIFEST_SHA256=d36d0c4fe183ba9a98f0a3471486be5dee1cf1fa820dc32b3a50177ce322be21

FRONTEND_PORT=8088
