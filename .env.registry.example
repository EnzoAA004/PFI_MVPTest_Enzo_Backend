# Stack PFI RM Lumbar - modo registry (compose.yml)
#
# Copiar como `.env` en la misma carpeta que compose.yml. No hace falta clonar ningun
# repositorio ni tener Java, Node o Python.
#
#   docker compose pull
#   docker compose up

# Version de las tres imagenes. `latest` sigue a main. Para reproducir una version exacta
# usar el tag que publica el CI por commit, por ejemplo:
#   PFI_IMAGE_TAG=sha-c532d2b0f1e2...
PFI_IMAGE_TAG=latest

# ---- Base de datos ----
POSTGRES_DB=pfi_backend
POSTGRES_USER=pfi
POSTGRES_PASSWORD=change-me-local-only
# Puerto en el host. Solo hace falta si se quiere inspeccionar la base desde afuera.
POSTGRES_PORT=54329

# ---- Puertos publicados ----
BACKEND_PORT=8080
FRONTEND_PORT=8088

# URL con la que el navegador llega al backend. Si se cambia BACKEND_PORT, cambiar aca
# tambien. No usar `http://backend:8080`: ese nombre solo existe dentro de la red de
# Docker y el navegador no lo resuelve.
BACKEND_PUBLIC_URL=http://localhost:8080

# Origenes que el backend acepta por CORS. Tiene que coincidir con FRONTEND_PORT.
PFI_CORS_ALLOWED_ORIGINS=http://localhost:8088

# ---- Backend ----
# Cambiar por una cadena larga y propia si el stack va a ser accesible desde afuera.
PFI_AUTH_JWT_SECRET=change-me-local-jwt-secret
PFI_AI_TIMEOUT_SECONDS=180
PFI_AI_SERVICE_MULTIPLANAR_CONTRACT_VERSION=v2
PFI_AI_STUDY_UPLOAD_MAX_BYTES=209715200

# Habilita POST /api/auth/demo-doctor, que emite un token con rol ADMIN/DOCTOR/REVIEWER
# sin registro previo. Viene encendido para que se pueda entrar al sistema y evaluarlo
# sin dar de alta usuarios a mano.
#
# ADVERTENCIA: apagarlo (false) en cualquier despliegue accesible desde fuera de la
# maquina. Con esto encendido, cualquiera que llegue al puerto obtiene un token de
# administrador. El compose por si solo es fail-closed: si esta variable falta, queda en
# false.
PFI_AUTH_DEMO_ENABLED=true

# ---- Que NO incluye este modo ----
#
# Los clasificadores de P10.6 (subarticular) y P10.7 (degenerativo discal) no viajan en la
# imagen del modulo de IA: son artefactos de release que todavia no se publican. El
# sistema arranca igual y todo lo demas funciona; esos dos endpoints responden 503 y
# GET /health los reporta como `not_configured`. Los modelos de segmentacion sagital y
# axial si estan incluidos, asi que la inferencia principal funciona.
